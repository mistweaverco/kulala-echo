{
  "name": "@mistweaverco/kulala-echo",
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun --external @grpc/grpc-js --external @grpc/proto-loader --external @grpc/reflection",
    "start": "bun run src/index.ts",
    "dev": "bun run --hot src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "main": "dist/index.js",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "hono": "4.12.27",
    "jose": "^6.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.4.0",
    "@types/bun": "1.3.14",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "26.0.1",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}
